# Les tests tournent sur une base distincte : `dbname_suffix` de doctrine.yaml
# y ajoute « _test ». La base de développement n'est donc jamais vidée par une
# suite de tests — et l'inverse est arrivé sur le dépôt voisin.
APP_ENV=test

# ⚠ APP_DEBUG=1 ET NON 0, ET CE N'EST PAS UN CONFORT DE DÉVELOPPEMENT.
#
# Un noyau Symfony non débogué NE VÉRIFIE PAS la fraîcheur de son conteneur
# compilé : il charge `var/cache/test/…Container.php` tel quel, sans comparer
# les dates des fichiers de configuration. Mesuré sur ce dépôt le 7 octobre
# 2026, avec APP_DEBUG=0 :
#
#   1. retirer `and subject.amendeDeuxPourCentPayee()` de la garde
#      `eteindre_action_publique` dans `config/packages/workflow.yaml` ;
#   2. lancer `vendor/bin/phpunit --filter leDesistementSeulNEteintPas` ;
#   3. « OK (1 test, 3 assertions) ».
#
# Autrement dit : LES 703 LIGNES DE RÈGLES DE DROIT DE `workflow.yaml`
# pouvaient être modifiées sans qu'aucun test ne rougisse. Sur un projet dont
# la valeur entière est que les gardes légales soient vérifiées, c'est la
# pire défaillance possible — une suite verte qui ne teste plus rien.
#
# Le même piège a aussi fait échouer huit tests pour la raison inverse : le
# conteneur gardait un service `App\Security\DossierVoter` d'une disposition
# de fichiers antérieure, classe qui n'existait plus, et le message
# — « Class "App\Security\DossierVoter" not found » — ne nommait ni le cache
# ni la cause.
#
# Le coût est un recalcul du conteneur au premier test après une modification
# de configuration. La suite complète passe de 1,5 s à 3,5 s. C'est le prix
# d'une suite qui dit la vérité.
APP_DEBUG=1

APP_SECRET=tests_uniquement

KERNEL_CLASS='App\Kernel'

# Le coût de hachage est abaissé dans security.yaml ; ici on neutralise les
# limites de PHPUnit sur les notices dépréciées des dépendances.
SYMFONY_DEPRECATIONS_HELPER=weak
