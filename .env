# Configuration par défaut du projet, VERSIONNÉE.
#
# Ce fichier ne contient aucun secret : la base de développement est locale,
# son mot de passe est le même que son nom, et APP_SECRET ne protège ici qu'un
# cookie de session de démonstration. Les vraies valeurs de production vivent
# chez l'hébergeur, en variables d'environnement.
#
# Aucune variable n'est posée dans `docker-compose.yml`, et c'est délibéré :
# une variable d'environnement du conteneur écrase TOUT, y compris ce fichier,
# `.env.test` et les valeurs de `phpunit.xml.dist`. Sur le dépôt voisin, la
# suite de tests a tourné une fois sur la base de DÉVELOPPEMENT à cause de
# cela, et l'a vidée.

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=developpement_uniquement_remplacee_en_production

# L'hôte est « postgres », le nom du service dans docker-compose.yml : c'est le
# nom que Docker résout DANS le réseau du projet. Depuis Windows, la même base
# s'atteint sur 127.0.0.1:5434.
#
# `serverVersion=16` évite un aller-retour : sans elle, Doctrine interroge la
# base au premier appel pour découvrir sa version.
DATABASE_URL="postgresql://tasswiya:tasswiya@postgres:5432/tasswiya?serverVersion=16&charset=utf8"

# La file d'attente est dans la base, pas dans Redis (voir messenger.yaml).
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
